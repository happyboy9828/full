{
  "version": 2,
  "builds": [
    {
      "src": "api.js",
      "use": "vercel-node-builder",
      "config": {
        "includeFiles": ["**"],
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    { "src": "/api/analytics/(.*)", "dest": "/api" },
    { "src": "/api/auth/(.*)", "dest": "/api" },
    { "src": "/health", "dest": "/api" },
    { "src": "/status", "dest": "/api" },
    { "src": "/(.*)", "dest": "/api" }
  ]
}
