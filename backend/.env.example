# Required for production deployment
ADMIN_PASSWORD=your-secure-password-here

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname?ssl=true&replicaSet=atlas

# CORS: comma-separated list of allowed frontend origins
# For Vercel: set to your frontend domain, e.g. https://your-app.vercel.app
# For local dev: http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Optional settings
PORT=5000
ADMIN_SESSION_TTL_DAYS=7
TRUST_PROXY=true
